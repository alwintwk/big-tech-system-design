{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Airbnb: booking a stay, step by step",
    "output": "diagrams/companies-airbnb-booking.html",
    "viewBox": [
      1080,
      582
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "default": {
          "label": "Service step"
        },
        "emphasis": {
          "label": "Booking / pay"
        },
        "return": {
          "label": "Reply"
        }
      }
    }
  },
  "participants": [
    {
      "id": "g",
      "type": "external",
      "label": "Guest",
      "sublabel": "books a stay"
    },
    {
      "id": "fe",
      "type": "frontend",
      "label": "Frontend",
      "sublabel": "web / app"
    },
    {
      "id": "bs",
      "type": "backend",
      "label": "Booking service",
      "sublabel": "owns the reservation"
    },
    {
      "id": "as",
      "type": "database",
      "label": "Calendar",
      "sublabel": "availability DB"
    },
    {
      "id": "po",
      "type": "backend",
      "label": "Payments",
      "sublabel": "orchestrator"
    },
    {
      "id": "psp",
      "type": "external",
      "label": "Processor",
      "sublabel": "card / wallet"
    },
    {
      "id": "lg",
      "type": "database",
      "label": "Ledger",
      "sublabel": "double-entry"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "g",
      "to": "fe",
      "y": 170,
      "label": "1. Request to book",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "fe",
      "to": "bs",
      "y": 198,
      "label": "2. Create reservation request",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "bs",
      "to": "as",
      "y": 226,
      "label": "3. Hold the nights",
      "variant": "default"
    },
    {
      "id": "m4",
      "from": "as",
      "to": "bs",
      "y": 254,
      "label": "4. Nights held",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "bs",
      "to": "po",
      "y": 282,
      "label": "5. Charge (idempotency key)",
      "variant": "emphasis"
    },
    {
      "id": "m6",
      "from": "po",
      "to": "psp",
      "y": 310,
      "label": "6. Charge the card",
      "variant": "default"
    },
    {
      "id": "m7",
      "from": "psp",
      "to": "po",
      "y": 338,
      "label": "7. Payment authorized",
      "variant": "return"
    },
    {
      "id": "m8",
      "from": "po",
      "to": "lg",
      "y": 366,
      "label": "8. Record double-entry",
      "variant": "default"
    },
    {
      "id": "m9",
      "from": "po",
      "to": "bs",
      "y": 394,
      "label": "9. Payment captured",
      "variant": "return"
    },
    {
      "id": "m10",
      "from": "bs",
      "to": "as",
      "y": 422,
      "label": "10. Confirm nights as booked",
      "variant": "default"
    },
    {
      "id": "m11",
      "from": "bs",
      "to": "fe",
      "y": 450,
      "label": "11. Reservation confirmed",
      "variant": "return"
    },
    {
      "id": "m12",
      "from": "fe",
      "to": "g",
      "y": 478,
      "label": "12. Confirmation shown",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Hold nights first, then charge, then confirm",
        "Conflict on the hold rejects the booking early"
      ]
    },
    {
      "dot": "orange",
      "title": "After the guest sees confirmation",
      "items": [
        "Host is notified by an async event",
        "Payout is released days after check-in"
      ]
    }
  ]
}