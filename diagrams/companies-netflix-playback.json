{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Netflix: pressing play",
    "output": "diagrams/companies-netflix-playback.html",
    "viewBox": [
      1080,
      526
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "default": {
          "label": "Backend call"
        },
        "emphasis": {
          "label": "Device request"
        },
        "security": {
          "label": "DRM check"
        },
        "return": {
          "label": "Reply"
        }
      }
    }
  },
  "participants": [
    {
      "id": "u",
      "type": "external",
      "label": "Device",
      "sublabel": "TV / phone"
    },
    {
      "id": "gw",
      "type": "backend",
      "label": "Zuul gateway",
      "sublabel": "front door"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "PlayAPI",
      "sublabel": "playback brain"
    },
    {
      "id": "drm",
      "type": "security",
      "label": "License / DRM",
      "sublabel": "signed manifest"
    },
    {
      "id": "st",
      "type": "backend",
      "label": "Steering",
      "sublabel": "picks OCAs"
    },
    {
      "id": "o",
      "type": "database",
      "label": "Open Connect box",
      "sublabel": "video cache (OCA)"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "u",
      "to": "gw",
      "y": 170,
      "label": "1. Request playback for a title",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "gw",
      "to": "api",
      "y": 198,
      "label": "2. Route to PlayAPI",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "api",
      "to": "drm",
      "y": 226,
      "label": "3. Request license + manifest",
      "variant": "security"
    },
    {
      "id": "m4",
      "from": "drm",
      "to": "api",
      "y": 254,
      "label": "4. Signed manifest + bitrate ladder",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "api",
      "to": "st",
      "y": 282,
      "label": "5. Best OCAs for this client IP?",
      "variant": "default"
    },
    {
      "id": "m6",
      "from": "st",
      "to": "api",
      "y": 310,
      "label": "6. Ranked OCA list",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "api",
      "to": "u",
      "y": 338,
      "label": "7. Manifest + ranked OCA URLs",
      "variant": "return"
    },
    {
      "id": "m8",
      "from": "u",
      "to": "o",
      "y": 366,
      "label": "8. Request first video/audio segment",
      "variant": "emphasis"
    },
    {
      "id": "m9",
      "from": "o",
      "to": "u",
      "y": 394,
      "label": "9. Segment at chosen quality",
      "variant": "return"
    },
    {
      "id": "m10",
      "from": "u",
      "to": "o",
      "y": 422,
      "label": "10. Next segment (device picks quality)",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "If an OCA fails",
      "items": [
        "Device retries the next OCA in the ranked list"
      ]
    },
    {
      "dot": "emerald",
      "title": "Steady state",
      "items": [
        "After step 7 the device talks only to the OCA"
      ]
    }
  ]
}